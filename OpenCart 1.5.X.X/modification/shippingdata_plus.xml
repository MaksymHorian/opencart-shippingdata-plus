<script type="text/javascript"><!--
$(function() {
  var $tip = $('<div id="sdp-tip"></div>').appendTo('body').hide();
  $(document).on('mouseenter', '[data-sdp-tip]', function(e) {
    var text = $(this).attr('data-sdp-tip');
    if (!text) {
      return;
    }
    $tip.text(text).css({ left: e.pageX + 8, top: e.pageY + 12 }).show();
  });
  $(document).on('mousemove', '[data-sdp-tip]', function(e) {
    $tip.css({ left: e.pageX + 8, top: e.pageY + 12 });
  });
  $(document).on('mouseleave', '[data-sdp-tip]', function() {
    $tip.hide();
  });
  $(document).on('click', '.sdp-copy', function(e) {
    e.preventDefault();
    var text = $(this).attr('data-number');
    var $button = $(this);
    var label = $button.text();
    var done = function() {
      $button.text('OK');
      setTimeout(function() { $button.text(label); }, 2000);
    };
    var area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', 'readonly');
    area.style.position = 'absolute';
    area.style.left = '-9999px';
    document.body.appendChild(area);
    area.select();
    try {
      if (document.execCommand('copy')) {
        done();
      }
    } catch (err) {}
    document.body.removeChild(area);
  });
  $('#sdp-truck-toggle').click(function(e) {
    e.preventDefault();
    $('#sdp-menu').toggleClass('open');
  });
  $(document).click(function(e) {
    if (!$(e.target).closest('#sdp-truck').length) {
      $('#sdp-menu').removeClass('open');
    }
  });
});
<?php if (!empty($shippingdata_plus_show)) { ?>
var sdpTextPing = <?php echo json_encode($shippingdata_plus_text_ping); ?>;
var sdpSuccessPing = <?php echo json_encode($shippingdata_plus_success_ping); ?>;
var sdpSuccessUpdate = <?php echo json_encode($shippingdata_plus_success_update); ?>;
var sdpToken = <?php echo json_encode($shippingdata_plus_token); ?>;
function sdpFormat(text, a, b) {
  var out = String(text).replace('%s', a);
  if (arguments.length > 2) {
    out = out.replace('%s', b);
  }
  return out;
}
function sdpCarrierName(code) {
  var name = $('#sdp-head-' + code).attr('data-name');
  return name ? name : code;
}
function sdpAlert(kind, message) {
  var box = $('<div class="sdp-alert">').addClass(kind === 'success' ? 'sdp-alert-success' : 'sdp-alert-danger');
  box.text(message);
  var host = $('#content');
  if (!host.length) {
    host = $('body');
  }
  host.first().prepend(box);
}
function sdpPing(code) {
  var label = $('#sdp-ping-' + code);
  var btn = $('#sdp-ping-btn-' + code);
  if (btn.attr('disabled')) {
    return;
  }
  $.ajax({
    url: 'index.php?route=module/shippingdata_plus/ping&token=' + encodeURIComponent(sdpToken) + '&carrier=' + encodeURIComponent(code),
    dataType: 'json',
    beforeSend: function() { btn.attr('disabled', 'disabled').text('...'); },
    complete: function() { btn.removeAttr('disabled').text(<?php echo json_encode($shippingdata_plus_button_check); ?>); },
    success: function(json) {
      label.css('color', '');
      if (!json) {
        return;
      }
      var color = json.color === 'success' ? '#3c763d' : (json.color === 'warning' ? '#8a6d3b' : '#a94442');
      if (json.ok) {
        label.css('color', color).text(sdpFormat(sdpTextPing, json.ms));
        sdpAlert('success', sdpFormat(sdpSuccessPing, sdpCarrierName(code), json.ms));
      } else {
        label.css('color', '#a94442').text(json.error || '');
        sdpAlert('danger', json.error || '');
      }
    }
  });
}
function sdpUpdate(code, type) {
  var btn = $('#sdp-refresh-' + code + '-' + type);
  if (btn.attr('disabled')) {
    return;
  }
  $.ajax({
    url: 'index.php?route=module/shippingdata_plus/update&token=' + encodeURIComponent(sdpToken) + '&carrier=' + encodeURIComponent(code) + '&type=' + encodeURIComponent(type),
    dataType: 'json',
    timeout: 0,
    beforeSend: function() { btn.attr('disabled', 'disabled').text('...'); },
    complete: function() { btn.removeAttr('disabled').text(<?php echo json_encode($shippingdata_plus_button_refresh); ?>); },
    success: function(json) {
      var delta = $('#sdp-delta-' + code + '-' + type);
      if (!json) {
        return;
      }
      if (json.error && typeof json.count === 'undefined') {
        delta.css('color', '#a94442').text(json.error);
        sdpAlert('danger', json.error);
        return;
      }
      if (typeof json.count !== 'undefined') {
        $('#sdp-count-' + code + '-' + type).text(json.count);
      }
      if (json.error) {
        delta.css('color', '#a94442').text(json.error);
        sdpAlert('danger', json.error);
        return;
      }
      var n = parseInt(json.delta, 10);
      if (isNaN(n)) {
        n = 0;
      }
      var signed = n > 0 ? '+' + n : String(n);
      delta.css('color', '#1e1e1e').text(signed);
      sdpAlert('success', sdpFormat(sdpSuccessUpdate, sdpCarrierName(code), signed));
    }
  });
}
<?php } ?>
//--></script>
]]></add>
