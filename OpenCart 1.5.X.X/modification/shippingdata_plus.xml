<?php if (!empty($shippingdata_plus_list)) { ?>
<script type="text/javascript"><!--
(function() {
  var copyTitle = <?php echo json_encode($shippingdata_plus_copy); ?>;
  var trackTitle = <?php echo json_encode($shippingdata_plus_track); ?>;

  function shippingdataPlusLink(url) {
    return /^https:\/\/(novaposhta\.ua|track\.ukrposhta\.ua|rozetka\.delivery|ua\.meest\.com)\//.test(url);
  }
  function shippingdataPlusHex(value) {
    return /^#[0-9A-Fa-f]{6}$/.test(String(value || '')) ? String(value) : '';
  }
  function shippingdataPlusFill(cell, row) {
    if (!cell || !cell.length || !row || !row.number) {
      return;
    }
    var shown = row.display ? String(row.display) : String(row.number);
    cell.append($('<span class="sdp-num">').text(shown));
    var copy = $('<button type="button" class="sdp-btn sdp-btn-xs sdp-copy sdp-tip">').attr('data-number', row.number).attr('data-sdp-tip', copyTitle).text(copyTitle);
    cell.append(document.createTextNode(' '));
    cell.append(copy);
    if (row.tracking && shippingdataPlusLink(row.tracking)) {
      var link = $('<a class="sdp-btn sdp-btn-xs sdp-tip" target="_blank">').attr('href', row.tracking).attr('data-sdp-tip', trackTitle).text('\u2192');
      var bg = shippingdataPlusHex(row.bg);
      var ink = shippingdataPlusHex(row.ink);
      if (bg && ink) {
        link.css({ backgroundColor: bg, borderColor: bg, color: ink });
      }
      cell.append(document.createTextNode(' '));
      cell.append(link);
    }
  }
  $('#form td[colspan]').each(function() {
    var span = parseInt($(this).attr('colspan'), 10);
    if (!isNaN(span)) {
      $(this).attr('colspan', span + 1);
    }
  });
  var ids = [];
  $('.sdp-cn').each(function() {
    ids.push($(this).attr('data-order-id'));
  });
  if (!ids.length) {
    return;
  }
  $.ajax({
    url: 'index.php?route=module/shippingdata_plus/orders&token=' + encodeURIComponent(<?php echo json_encode($token); ?>),
    type: 'POST',
    data: { order_id: ids },
    dataType: 'json',
    success: function(json) {
      if (!json || !json.orders) {
        return;
      }
      $.each(json.orders, function(id, row) {
        if (!/^[0-9]+$/.test(String(id))) {
          return;
        }
        shippingdataPlusFill($('.sdp-cn').filter(function() {
          return String($(this).attr('data-order-id')) === String(id);
        }), row);
      });
    }
  });
})();
//--></script>
<?php } ?>
]]></add>
		</operation>
