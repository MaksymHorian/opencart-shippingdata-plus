			<search><![CDATA[<?php echo $footer; ?>]]></search>
			<add position="before"><![CDATA[
<?php if (!empty($shippingdata_plus_list)) { ?>
<script type="text/javascript"><!--
(function() {
  var copyTitle = <?php echo json_encode($shippingdata_plus_copy); ?>;
  var trackTitle = <?php echo json_encode($shippingdata_plus_track); ?>;

  function shippingdataPlusCopy(text, button) {
    var done = function() {
      var icon = $(button).find('i');
      icon.removeClass('fa-clipboard').addClass('fa-check text-success');
      var timer = $(button).data('sdpTimer');
      if (timer) {
        clearTimeout(timer);
      }
      $(button).data('sdpTimer', setTimeout(function() {
        icon.removeClass('fa-check text-success').addClass('fa-clipboard');
      }, 2000));
    };
    var fallback = function() {
      var area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', 'readonly');
      area.style.position = 'absolute';
      area.style.left = '-9999px';
      document.body.appendChild(area);
      area.select();
      var ok = false;
      try {
        ok = document.execCommand('copy');
      } catch (err) {
        ok = false;
      }
      document.body.removeChild(area);
      if (ok) {
        done();
      }
    };
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(done).catch(fallback);
    } else {
      fallback();
    }
  }

  function shippingdataPlusLink(url) {
    return /^https:\/\/(novaposhta\.ua|track\.ukrposhta\.ua|rozetka\.delivery|ua\.meest\.com)\//.test(url);
  }

  function shippingdataPlusHex(value) {
    return /^#[0-9A-Fa-f]{6}$/.test(String(value || '')) ? String(value) : '';
  }

  function shippingdataPlusTrack(row) {
    if (!row || !shippingdataPlusLink(row.tracking)) {
      return null;
    }
    var bg = shippingdataPlusHex(row.bg);
    var ink = shippingdataPlusHex(row.ink);
    var link = $('<a class="btn btn-xs" target="_blank" rel="noopener noreferrer" style="margin-left:4px;">');
    link.attr('href', row.tracking);
    link.attr('data-toggle', 'tooltip');
    link.attr('title', trackTitle);
    if (bg && ink) {
      link.css({ backgroundColor: bg, borderColor: bg, color: ink });
    }
    link.html('<i class="fa fa-external-link"></i>');
    return link;
  }

  function shippingdataPlusFill(cell, row) {
    if (!cell || !cell.length || !row || !row.number) {
      return;
    }
    var shown = row.display ? String(row.display) : String(row.number);
    cell.append($('<span style="white-space:nowrap;">').text(shown));
    var copy = $('<button type="button" class="btn btn-default btn-xs" style="margin-left:4px;">').attr('data-toggle', 'tooltip').attr('title', copyTitle).html('<i class="fa fa-clipboard"></i>');
    copy.on('click', function(e) {
      e.preventDefault();
      shippingdataPlusCopy(String(row.number), this);
    });
    cell.append(copy);
    if ($.fn.tooltip) {
      copy.tooltip({container: 'body'});
    }
    var track = shippingdataPlusTrack(row);
    if (track) {
      cell.append(track);
      if ($.fn.tooltip) {
        track.tooltip({container: 'body'});
      }
    }
  }

  $('#form-order td[colspan]').each(function() {
    var span = parseInt($(this).attr('colspan'), 10);
    if (!isNaN(span)) {
      $(this).attr('colspan', span + 1);
    }
  });

  var ids = [];
  $('.sdp-cn').each(function() {
    ids.push($(this).attr('data-order-id'));
  });
  if (!ids.length) {
    return;
  }
  $.ajax({
    url: 'index.php?route=extension/module/shippingdata_plus/orders&token=' + encodeURIComponent(<?php echo json_encode($token); ?>),
    type: 'POST',
    data: { order_id: ids },
    dataType: 'json',
    success: function(json) {
      if (!json || !json.orders) {
        return;
      }
      $.each(json.orders, function(id, row) {
        if (!/^[0-9]+$/.test(String(id))) {
          return;
        }
        shippingdataPlusFill($('.sdp-cn').filter(function() {
          return String($(this).attr('data-order-id')) === String(id);
        }), row);
      });
    }
  });
})();
//--></script>
<?php } ?>
]]></add>
		</operation>
	</file>

