.sdp-menu > li.dropdown-header > a.btn { display: inline-block; float: none; clear: none; margin-left: 6px; padding: 1px 5px; line-height: 1.5; vertical-align: middle; }
</style>
<script type="text/javascript"><!--
var sdpTextPing = <?php echo json_encode($shippingdata_plus_text_ping); ?>;
var sdpSuccessPing = <?php echo json_encode($shippingdata_plus_success_ping); ?>;
var sdpSuccessUpdate = <?php echo json_encode($shippingdata_plus_success_update); ?>;
var sdpToken = <?php echo json_encode($shippingdata_plus_token); ?>;

function sdpFormat(text, a, b) {
  var out = String(text).replace('%s', a);
  if (arguments.length > 2) {
    out = out.replace('%s', b);
  }
  return out;
}

function sdpCarrierName(code) {
  var name = $('#sdp-head-' + code).attr('data-name');
  return name ? name : code;
}

function sdpAlert(kind, message) {
  var $box = $('<div class="alert alert-dismissible">').addClass(kind === 'success' ? 'alert-success' : 'alert-danger');
  $box.append($('<i class="fa">').addClass(kind === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'));
  $box.append(document.createTextNode(' ' + message + ' '));
  $box.append('<button type="button" class="close" data-dismiss="alert">&times;</button>');
  var $host = $('#content > .container-fluid');
  if (!$host.length) {
    $host = $('#content');
  }
  if (!$host.length) {
    $host = $('body');
  }
  $host.first().prepend($box);
}

function sdpPing(code) {
  var $label = $('#sdp-ping-' + code);
  var $btn = $('#sdp-ping-btn-' + code);
  var $icon = $btn.children('i');
  if ($btn.prop('disabled')) {
    return;
  }
  $.ajax({
    url: 'index.php?route=extension/module/shippingdata_plus/ping&token=' + encodeURIComponent(sdpToken) + '&carrier=' + encodeURIComponent(code),
    dataType: 'json',
    beforeSend: function() {
      $btn.prop('disabled', true);
      $icon.attr('data-sdp-icon', $icon.attr('class')).attr('class', 'fa fa-spinner fa-spin');
    },
    complete: function() {
      $btn.prop('disabled', false);
      $icon.attr('class', $icon.attr('data-sdp-icon') || 'fa fa-plug');
    },
    success: function(json) {
      $label.removeClass('text-success text-warning text-danger');
      if (!json) {
        return;
      }
      if (json.color === 'success' || json.color === 'warning' || json.color === 'danger') {
        $label.addClass('text-' + json.color);
      }
      if (json.ok) {
        $label.text(sdpFormat(sdpTextPing, json.ms));
        sdpAlert('success', sdpFormat(sdpSuccessPing, sdpCarrierName(code), json.ms));
      } else {
        $label.addClass('text-danger').text(json.error || '');
        sdpAlert('danger', json.error || '');
      }
    }
  });
}
function sdpUpdate(code, type) {
  var $btn = $('#sdp-refresh-' + code + '-' + type);
  var $icon = $btn.children('i');
  if ($btn.prop('disabled')) {
    return;
  }
  $.ajax({
    url: 'index.php?route=extension/module/shippingdata_plus/update&token=' + encodeURIComponent(sdpToken) + '&carrier=' + encodeURIComponent(code) + '&type=' + encodeURIComponent(type),
    dataType: 'json',
    timeout: 0,
    beforeSend: function() {
      $btn.prop('disabled', true);
      $icon.attr('data-sdp-icon', $icon.attr('class')).attr('class', 'fa fa-spinner fa-spin');
    },
    complete: function() {
      $btn.prop('disabled', false);
      $icon.attr('class', $icon.attr('data-sdp-icon') || 'fa fa-refresh');
    },
    success: function(json) {
      var $delta = $('#sdp-delta-' + code + '-' + type);
      $delta.removeClass('text-danger');
      if (!json) {
        return;
      }
      if (json.error && typeof json.count === 'undefined') {
        $delta.addClass('text-danger').text(json.error);
        sdpAlert('danger', json.error);
        return;
      }
      if (typeof json.count !== 'undefined') {
        $('#sdp-count-' + code + '-' + type).text(json.count);
      }
      if (json.error) {
        $delta.addClass('text-danger').text(json.error);
        sdpAlert('danger', json.error);
        return;
      }
      var delta = parseInt(json.delta, 10);
      if (isNaN(delta)) {
        delta = 0;
      }
      var signed = delta > 0 ? '+' + delta : String(delta);
      $delta.text(signed);
      sdpAlert('success', sdpFormat(sdpSuccessUpdate, sdpCarrierName(code), signed));
    }
  });
}
$(document).ready(function() {
  if ($.fn.tooltip) {
    $('#sdp-truck-toggle').tooltip({container: 'body'});
    $('.sdp-menu [data-toggle="tooltip"]').tooltip({container: 'body'});
  }
});
//--></script>
<?php } ?>
