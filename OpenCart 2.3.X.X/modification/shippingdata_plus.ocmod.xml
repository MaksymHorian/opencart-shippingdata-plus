<?php if (!empty($shippingdata_plus_show)) { ?>
<style>
.sdp-menu { min-width: 320px; }
.sdp-menu > li > .sdp-row { margin-left: 0; margin-right: 0; padding: 3px 15px; }
.sdp-menu > li > .sdp-row > [class*="col-"] { padding: 2px 4px; }
