<div id="sdp-order-info" class="hidden"> <span style="display:inline-flex;align-items:center;line-height:1;white-space:nowrap;"><?php echo htmlspecialchars($shippingdata_plus['display'], ENT_QUOTES, 'UTF-8'); ?> <button type="button" class="btn btn-default btn-xs sdp-copy" data-number="<?php echo htmlspecialchars($shippingdata_plus['number'], ENT_QUOTES, 'UTF-8'); ?>" data-toggle="tooltip" title="<?php echo htmlspecialchars($shippingdata_plus_copy, ENT_QUOTES, 'UTF-8'); ?>" style="margin-left:4px;"><i class="fa fa-clipboard"></i></button> <?php if (!empty($shippingdata_plus['tracking'])) { ?><a class="btn btn-xs" href="<?php echo htmlspecialchars($shippingdata_plus['tracking'], ENT_QUOTES, 'UTF-8'); ?>" target="_blank" rel="noopener noreferrer" data-toggle="tooltip" title="<?php echo htmlspecialchars($shippingdata_plus_track, ENT_QUOTES, 'UTF-8'); ?>" style="margin-left:4px;background-color:<?php echo htmlspecialchars($shippingdata_plus['bg'], ENT_QUOTES, 'UTF-8'); ?>;border-color:<?php echo htmlspecialchars($shippingdata_plus['bg'], ENT_QUOTES, 'UTF-8'); ?>;color:<?php echo htmlspecialchars($shippingdata_plus['ink'], ENT_QUOTES, 'UTF-8'); ?>;"><i class="fa fa-external-link"></i></a><?php } ?></span></div>
<script type="text/javascript"><!--
(function() {
  var box = document.getElementById('sdp-order-info');
  var button = document.getElementById('sdp-shipping-method');
  var cell = button && button.parentNode ? button.parentNode.nextElementSibling : null;
  if (box && cell) {
    while (box.firstChild) {
      cell.appendChild(box.firstChild);
    }
    cell.style.display = 'flex';
    cell.style.alignItems = 'center';
    cell.style.justifyContent = 'space-between';
    cell.style.gap = '8px';
    if (box.parentNode) {
      box.parentNode.removeChild(box);
    }
    if (window.jQuery && jQuery.fn.tooltip) {
      jQuery(cell).find('[data-toggle="tooltip"]').tooltip({container: 'body'});
    }
  }
  function done(target) {
    var icon = target.querySelector('i');
    if (!icon) {
      return;
    }
    icon.className = 'fa fa-check text-success';
    if (target.sdpTimer) {
      clearTimeout(target.sdpTimer);
    }
    target.sdpTimer = setTimeout(function() {
      icon.className = 'fa fa-clipboard';
    }, 2000);
  }
  var copies = cell ? cell.querySelectorAll('.sdp-copy') : [];
  for (var i = 0; i < copies.length; i++) {
    copies[i].addEventListener('click', function() {
      var text = this.getAttribute('data-number');
      var target = this;
      var fallback = function() {
        var area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', 'readonly');
        area.style.position = 'absolute';
        area.style.left = '-9999px';
        document.body.appendChild(area);
        area.select();
        var ok = false;
        try {
          ok = document.execCommand('copy');
        } catch (err) {
          ok = false;
        }
        document.body.removeChild(area);
        if (ok) {
          done(target);
        }
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(function() { done(target); }).catch(fallback);
      } else {
        fallback();
      }
    });
  }
})();
//--></script>
<?php } ?>
]]></add>
		</operation>
	</file>

