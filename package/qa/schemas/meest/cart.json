    {
      "id": "pair.all_methods_off",
      "note": "No quotes when every method disabled",
      "patches": {
        "shipping_methods.department.status": "",
        "shipping_methods.poshtomat.status": "",
        "shipping_methods.doors.status": ""
      },
      "expect": { "quote_null": true }
    },
    {
      "id": "pair.tariff_only_department",
      "note": "API off, tariff on — still quote with empty address_1",
      "patches": {
        "shipping_methods.department.api_calculation": "",
        "shipping_methods.department.tariff_calculation": "on",
        "shipping_methods.department.cost": "on",
        "shipping_methods.department.free_shipping": ""
      },
      "expect": { "codes_present": ["department"], "cost_gt": { "department": 0 } }
    },
    {
      "id": "pair.no_cost_engines",
      "note": "Cost on but both engines off → zero cost",
      "patches": {
        "shipping_methods.doors.api_calculation": "",
        "shipping_methods.doors.tariff_calculation": "",
        "shipping_methods.doors.cost": "on",
        "shipping_methods.doors.free_shipping": ""
      },
      "expect": { "codes_present": ["doors"], "cost_eq": { "doors": 0 } }
    },
    {
      "id": "pair.api_only_with_dept",
      "note": "API on, tariff off, department selected in address",
      "address_key": "kyiv_with_dept",
      "patches": {
        "shipping_methods.department.api_calculation": "on",
        "shipping_methods.department.tariff_calculation": "",
        "shipping_methods.department.cost": "on",
        "shipping_methods.department.free_shipping": ""
      },
      "expect": { "codes_present": ["department"], "quote_ok": true }
    },
    {
      "id": "pair.free_shipping_all_methods",
      "note": "Free shipping threshold low — all methods zero cost",
      "patches": {
        "shipping_methods.department.free_shipping": "1",
        "shipping_methods.poshtomat.free_shipping": "1",
        "shipping_methods.doors.free_shipping": "1",
        "shipping_methods.department.cost": "on",
        "shipping_methods.poshtomat.cost": "on",
        "shipping_methods.doors.cost": "on"
      },
      "expect": {
        "codes_present": ["department", "poshtomat", "doors"],
        "cost_eq": { "department": 0, "poshtomat": 0, "doors": 0 }
      }
    },
    {
      "id": "pair.poshtomat_only",
      "note": "Only poshtomat enabled",
      "patches": {
        "shipping_methods.department.status": "",
        "shipping_methods.doors.status": "",
        "shipping_methods.poshtomat.status": "on"
      },
      "expect": { "codes_present": ["poshtomat"], "codes_absent": ["department", "doors"] }
    },
    {
      "id": "pair.doors_only",
      "note": "Only doors enabled",
      "patches": {
        "shipping_methods.department.status": "",
        "shipping_methods.poshtomat.status": "",
        "shipping_methods.doors.status": "on",
        "shipping_methods.doors.cost": "on",
        "shipping_methods.doors.tariff_calculation": "on"
      },
      "expect": { "codes_present": ["doors"], "codes_absent": ["department", "poshtomat"] }
    },
    {
      "id": "pair.cod_tariff_department",
      "note": "COD + tariff calculation on department",
      "session": { "payment_method": { "code": "cod" } },
      "patches": {
        "calculate_cod": "enabled",
        "payment_cod": ["cod"],
        "shipping_methods.department.api_calculation": "",
        "shipping_methods.department.tariff_calculation": "on",
        "shipping_methods.department.cost": "on"
      },
      "expect": { "codes_present": ["department"], "cost_gt": { "department": 0 } }
    }
  ]
