{
  "module": "meest",
  "setting_key": "shipping_meest",
  "flat_keys": ["shipping_meest_status"],
  "seed_rows": [
    {
      "cn_number": "QA-MATRIX-001",
      "order_number": "9001",
      "recipient": "Alpha QA",
      "recipient_phone": "380501111111",
      "created_at": "2026-01-10 10:00:00",
      "status": "created"
    },
    {
      "cn_number": "QA-MATRIX-002",
      "order_number": "9002",
      "recipient": "Beta QA",
      "recipient_phone": "380502222222",
      "created_at": "2026-02-15 12:00:00",
      "status": "in_transit"
    },
    {
      "cn_number": "QA-MATRIX-003",
      "order_number": "9003",
      "recipient": "Gamma QA",
      "recipient_phone": "380503333333",
      "created_at": "2026-03-20 14:00:00",
      "status": "delivered"
    }
  ],
  "cases": [
    {
      "id": "list.all_seeded",
      "kind": "list_filter",
      "filter": { "cn_number": "QA-MATRIX" },
      "expect": { "count": 3, "total": 3 },
      "note": "All seeded rows match prefix"
    },
    {
      "id": "list.filter_cn_number",
      "kind": "list_filter",
      "filter": { "cn_number": "QA-MATRIX-002" },
      "expect": { "count": 1, "total": 1, "first_cn": "QA-MATRIX-002" }
    },
    {
      "id": "list.filter_order_number",
      "kind": "list_filter",
      "filter": { "order_number": "9001" },
      "expect": { "count": 1, "total": 1 }
    },
    {
      "id": "list.filter_recipient_name",
      "kind": "list_filter",
      "filter": { "recipient_name": "Beta" },
      "expect": { "count": 1, "total": 1 }
    },
    {
      "id": "list.filter_recipient_phone",
      "kind": "list_filter",
      "filter": { "recipient_phone": "380503333333" },
      "expect": { "count": 1, "total": 1 }
    },
    {
      "id": "list.filter_date_range",
      "kind": "list_filter",
      "filter": {
        "created_date_start": "2026-02-01",
        "created_date_end": "2026-02-28"
      },
      "expect": { "count": 1, "total": 1, "first_cn": "QA-MATRIX-002" }
    },
    {
      "id": "list.sort_asc",
      "kind": "list_filter",
      "filter": { "cn_number": "QA-MATRIX", "sort": "cn_number", "order": "ASC" },
      "expect": { "count_min": 3, "first_cn": "QA-MATRIX-001" }
    },
    {
      "id": "list.pagination",
      "kind": "list_filter",
      "filter": { "cn_number": "QA-MATRIX", "start": 0, "limit": 2 },
      "expect": { "count": 2, "total": 3 }
    },
    {
      "id": "print.default_sticker100",
      "kind": "print_resolve",
      "patches": { "print_format": "sticker100", "print_declaration_type": "pdf" },
      "expect": { "variant": "sticker100", "content_type": "pdf" }
    },
    {
      "id": "print.sticker100A4",
      "kind": "print_resolve",
      "patches": { "print_format": "sticker100A4", "print_start": "3" },
      "expect": { "variant": "sticker100A4" }
    },
    {
      "id": "print.cargo_declaration_pdf",
      "kind": "print_resolve",
      "patches": { "print_format": "cargo_declaration", "print_declaration_type": "pdf" },
      "get": { "print_format": "cargo_declaration" },
      "expect": { "variant": "cargo_declaration", "content_type": "pdf" }
    },
    {
      "id": "print.cargo_declaration_html_override",
      "kind": "print_resolve",
      "patches": { "print_format": "cargo_declaration", "print_declaration_type": "pdf" },
      "get": { "print_format": "cargo_declaration", "print_declaration_type": "html" },
      "expect": { "variant": "cargo_declaration", "content_type": "html" }
    },
    {
      "id": "print.get_overrides_settings",
      "kind": "print_resolve",
      "patches": { "print_format": "sticker100" },
      "get": { "print_format": "sticker100A4" },
      "expect": { "variant": "sticker100A4" },
      "note": "GET print_format overrides admin default"
    },
    {
      "id": "print.label_fake_barcode",
      "kind": "print_label_smoke",
      "barcode": "QA-FAKE-BARCODE-000",
      "variant": "sticker100",
      "expect": { "not_pdf": true },
      "note": "Helper callable; fake barcode must not return valid PDF"
    }
  ]
}
