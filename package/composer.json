{
    "name": "ocmax/package-tools",
    "description": "Dev tools for OC Max package scripts (lint, QA)",
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "tomasvotruba/unused-public": "^2.1.1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
