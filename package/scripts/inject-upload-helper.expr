(() => {
  window.__uploadHelper = {
    _name: '', _mime: '', _selector: '', _multiple: false, _b64: '',
    init(name, mime, selector, multiple) {
      this._name = name; this._mime = mime; this._selector = selector; this._multiple = !!multiple; this._b64 = '';
    },
    push(b64) { this._b64 = b64 || ''; },
    finish() {
      const bin = atob(this._b64);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      const file = new File([bytes], this._name, { type: this._mime });
      const input = document.querySelector(this._selector);
      if (!input) return 'NO_INPUT:' + this._selector;
      const dt = new DataTransfer();
      if (this._multiple && input.files && input.files.length) {
        for (let i = 0; i < input.files.length; i++) dt.items.add(input.files[i]);
      }
      dt.items.add(file);
      input.files = dt.files;
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.dispatchEvent(new Event('change', { bubbles: true }));
      return this._multiple ? input.files.length : input.files[0]?.name || 'OK';
    }
  };
  return 'HELPER_OK';
})()
