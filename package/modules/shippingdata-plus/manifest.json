{
  "module": "shippingdata-plus",
  "displayName": "Shipping Data Plus",
  "type": "other",
  "versionDefault": "v. 1.0.0",
  "github": "MaksymHorian/opencart-shippingdata-plus",
  "paths": {
    "homeRoot": "c:\\OpenServer\\home",
    "devSandbox": "oc3",
    "ocMaxProduct": "Shipping Data Plus",
    "repoName": "opencart-shippingdata-plus",
    "docsRelative": "docs\\shippingdata-plus"
  },
  "screenshots": {
    "outputRelativeToOcMax": "images",
    "specRelativeToDocs": "images"
  },
  "instruction": {
    "author": "Prorab337",
    "faviconUrl": "https://oc-max.com/docs/shippingdata-plus/images/favicon.ico"
  },
  "sharedLayers": {
    "shippingdata": false,
    "ocmax_license": false,
    "oc15AdminAssets": false
  },
  "propagate": {
    "targets": [],
    "php": {},
    "lang": { "locales": ["en-gb", "uk-ua", "ru-ru"] },
    "templatesManual": {}
  },
  "build": {
    "versions": [
      { "key": "oc3", "sandbox": "oc3", "ocmaxFolder": "OpenCart 3.X.X.X", "modType": "ocmod", "ocmodInstallerZip": true },
      { "key": "oc23", "sandbox": "oc23", "ocmaxFolder": "OpenCart 2.3.X.X", "modType": "ocmod", "ocmodInstallerZip": true },
      { "key": "oc21", "sandbox": "oc21", "ocmaxFolder": "OpenCart 2.0.0.0-2.2.0.0", "modType": "ocmod", "ocmodInstallerZip": true },
      { "key": "oc15", "sandbox": "oc15", "ocmaxFolder": "OpenCart 1.5.X.X", "modType": "vqmod" }
    ],
    "upload": {
      "oc3": [
        "admin\\controller\\extension\\module\\shippingdata_plus.php",
        "admin\\model\\extension\\module\\shippingdata_plus.php",
        "admin\\view\\template\\extension\\module\\shippingdata_plus.twig"
      ],
      "oc23": [
        "admin\\controller\\extension\\module\\shippingdata_plus.php",
        "admin\\model\\extension\\module\\shippingdata_plus.php",
        "admin\\view\\template\\extension\\module\\shippingdata_plus.tpl"
      ],
      "oc21": [
        "admin\\controller\\module\\shippingdata_plus.php",
        "admin\\model\\module\\shippingdata_plus.php",
        "admin\\view\\template\\module\\shippingdata_plus.tpl"
      ],
      "oc15": [
        "admin\\controller\\module\\shippingdata_plus.php",
        "admin\\model\\module\\shippingdata_plus.php",
        "admin\\view\\template\\module\\shippingdata_plus.tpl",
        "admin\\view\\stylesheet\\shippingdata_plus.css"
      ]
    },
    "langFileFilters": ["shippingdata_plus.php"],
    "modifiers": {
      "ocmodGlob": "shippingdata_plus.ocmod.xml",
      "vqmodGlob": "shippingdata_plus.xml",
      "vqmodStripTrailingUnderscore": false
    }
  },
  "repo": {
    "devBranch": "dev",
    "releaseBranch": "release",
    "devDocs": {
      "directories": [
        "docs\\shippingdata-plus",
        "docs\\instruction"
      ],
      "files": [
        "docs\\dev-environment.md",
        "docs\\multi-version.md"
      ]
    }
  },
  "releaseAssets": {
    "instructionSource": "docs\\shippingdata-plus\\instruction.html",
    "rootFiles": ["instruction.html"],
    "rootDirs": [],
    "obsoleteRootFiles": []
  }
}
