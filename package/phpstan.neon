includes:
    - phpstan-baseline.neon
    - vendor/tomasvotruba/unused-public/config/extension.neon

parameters:
    level: 4
    phpVersion: 80100
    bootstrapFiles:
        - phpstan/stubs-cart.php
        - phpstan/stubs.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    # OpenCart serves models and libraries from the registry via __get(), so $this->db,
    # $this->model_* and $this->weight are never declared anywhere in the source. Treating
    # these classes as property bags keeps that noise out of module files. The carrier
    # helpers are standalone but use the same registry __get(), so they belong here too.
    universalObjectCratesClasses:
        - stdClass
        - Controller
        - Model
        - Meest
        - NovaPoshta
        - NovaposhtaPro
        - NovaposhtaProLicence
        - UkrPoshta
        - RozetkaDelivery
    excludePaths:
        - ../system/storage/*
        - ../image/*
    # OpenCart routes/models look "unused" from PHP; dead-public gate is for helpers only.
    unused_public:
        methods: true
        # Off: "used only locally → make private" floods helpers; we want never-used dead code.
        local_methods: false
        properties: true
        constants: false
        template_paths: []
    ignoreErrors:
        - '#Unsafe usage of new static\(\)#'
        -
            identifier: public.method.unused
            paths:
                - ../admin/*
                - ../catalog/*
                - ../package/*
        -
            identifier: public.property.unused
            paths:
                - ../admin/*
                - ../catalog/*
                - ../package/*
        # stubs.php pins VERSION to the sandbox release, so every version_compare(VERSION, ...)
        # branch is provably constant here while still being required on OC 2.x / 1.5.
        -
            identifier: if.alwaysTrue
            paths:
                - ../admin/*
                - ../catalog/*
